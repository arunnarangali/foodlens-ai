# Placeholders only: replace and export in the backend shell. Go does not load .env.
# Actual defaults: SERVER_ADDR 127.0.0.1:8080, OLLAMA_BASE_URL https://ollama.com/api,
# OLLAMA_TIMEOUT_SECONDS 120. Model/key must be supplied; no VITE_* secrets.
SERVER_ADDR=replace_with_local_host_and_port
OLLAMA_BASE_URL=replace_with_https_ollama_com_api
OLLAMA_API_KEY=replace_with_your_ollama_api_key
OLLAMA_MODEL=replace_with_verified_vision_model_id
OLLAMA_TIMEOUT_SECONDS=replace_with_seconds_from_1_to_180
